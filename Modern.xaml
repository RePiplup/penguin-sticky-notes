<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="鹅鹅便利贴" Width="410" Height="620" MinWidth="300" MinHeight="450" WindowStyle="None" ResizeMode="CanResize" Background="#FFFCF4" FontFamily="幼圆" FontWeight="Bold" FontSize="14" Foreground="#353A36" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#77796E"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#16000000"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6AD94"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="FontFamily" Value="幼圆"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#354452"/><Setter Property="CaretBrush" Value="#397CBD"/><Setter Property="SelectionBrush" Value="#BEDBF3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,2"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Width" Value="22"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Ellipse x:Name="Circle" Width="18" Height="18" Stroke="#BACBDA" StrokeThickness="1.2"/><Path x:Name="Tick" Data="M 6,12 L 9.5,15.5 L 16,8.5" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#5C96C8"/><Setter TargetName="Circle" Property="Stroke" Value="#5C96C8"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="#5C96C8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="StrokeThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="#CECFC3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="Paper" BorderBrush="#E3E0D6" BorderThickness="1" CornerRadius="12" Background="#FFFCF4">
  <Grid Margin="20,12,20,16">
   <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DragBar" Background="Transparent">
    <TextBlock Text="鹅鹅便利贴" FontSize="14" Foreground="#79745E" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="Pin" Style="{StaticResource Icon}" Content="&#xE718;" ToolTip="取消置顶"/>
     <Button x:Name="More" Style="{StaticResource Icon}" Content="&#xE712;" ToolTip="便笺选项"/>
     <Button x:Name="HideNote" Style="{StaticResource Icon}" Content="&#xE921;" ToolTip="隐藏到系统托盘"/>
     <Button x:Name="CloseNote" Style="{StaticResource Icon}" Content="&#xE8BB;" ToolTip="保存并退出"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="2,14,2,14">
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock x:Name="Headline" Text="专注当下，稳步推进" TextWrapping="Wrap" FontSize="16" Foreground="#344D62"/><TextBlock Text="今日计划 · 逐项完成" Margin="0,7,0,0" FontSize="11" Foreground="#A69A77"/></StackPanel>
     <Border Grid.Column="1" CornerRadius="16" Width="64" Height="64" ClipToBounds="True"><Border.Background><ImageBrush x:Name="GooseBrush" Stretch="UniformToFill"/></Border.Background></Border>
    </Grid>
    <Border Background="#FFF3CB" CornerRadius="10" Padding="11,9">
     <StackPanel><TextBlock x:Name="Date" TextWrapping="Wrap" FontSize="12" Foreground="#8C7954"/>
      <Button x:Name="Weather" HorizontalAlignment="Left" Padding="0,0" Margin="0,6,0,0" ToolTip="设置城市 / 刷新天气"><TextBlock x:Name="WeatherText" Text="设置城市 · 查看天气" FontSize="12" Foreground="#537FAA" TextWrapping="Wrap"/></Button>
     </StackPanel>
    </Border>
   </StackPanel>
   <ScrollViewer x:Name="TaskScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,5,0">
    <StackPanel x:Name="Tasks" Margin="0,0,0,8"/>
   </ScrollViewer>
   <Border Grid.Row="3" x:Name="Composer" Background="#F2F0E5" CornerRadius="10" Margin="0,16,0,0" Padding="12,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,8,0"><TextBlock x:Name="Placeholder" Text="添加一件待办…" Foreground="#A1A192" IsHitTestVisible="False" Margin="0,3"/><TextBox x:Name="Input" MinHeight="25" MaxHeight="110" VerticalScrollBarVisibility="Auto"/></Grid>
     <Button x:Name="Add" Grid.Column="1" Content="↑" FontFamily="Segoe UI" FontSize="19" Width="30" Height="30" Padding="0" VerticalAlignment="Bottom" Background="#F8D977" Foreground="#735D27" ToolTip="添加任务（Enter）；Shift+Enter 换行"/>
    </Grid>
   </Border>
   <Grid Grid.Row="4" Margin="4,12,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" FontSize="10" Foreground="#96988B"/><TextBlock Grid.Column="1" Text="Shift + Enter 换行" FontSize="10" Foreground="#ADB0A2"/></Grid>
  </Grid>
 </Border>
</Window>
